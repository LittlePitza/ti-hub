# Copia este archivo a .env.local y llena con los datos de tu proyecto Supabase
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Portal del empleado (app/portal): el servidor consulta con la service role key
# filtrando por el correo del empleado. NUNCA lleva prefijo NEXT_PUBLIC_ (solo servidor).
# Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Notificaciones por correo al solicitante (respuestas y cambios de estado).
# SMTP de Microsoft 365. Si falta cualquiera de estas, el envío se omite sin romper nada.
# Requiere habilitar "SMTP AUTH" en el buzón (Microsoft 365 admin) y, si hay MFA,
# usar una contraseña de aplicación. Solo servidor: NUNCA con prefijo NEXT_PUBLIC_.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=soporte.ti@plasticospimsa.com
SMTP_PASS=tu-contrasena-o-app-password
# Remitente que verá el empleado (por defecto, SMTP_USER) y nombre mostrado.
CORREO_REMITENTE=soporte.ti@plasticospimsa.com
CORREO_NOMBRE=Soporte TI · Plásticos PIMSA

# URL pública del portal, para el botón "Ver mis reportes" de los correos.
NEXT_PUBLIC_SITE_URL=https://soporte.plasticospimsa.com
