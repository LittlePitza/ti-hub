{
  "name": "ti-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Internal IT department site for Plásticos PIMSA: device inventory, maintenance scheduling, help-desk tickets and an employee self-service portal",
  "keywords": [
    "nextjs",
    "supabase",
    "typescript",
    "help-desk",
    "it-inventory",
    "internal-tool"
  ],
  "license": "UNLICENSED",
  "author": "Luis Hernández <sistemas@plasticospimsa.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittlePitza/ti-hub.git"
  },
  "bugs": {
    "url": "https://github.com/LittlePitza/ti-hub/issues"
  },
  "homepage": "https://github.com/LittlePitza/ti-hub#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.49.4",
    "next": "^15.3.2",
    "nodemailer": "^9.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.23",
    "prettier": "^3.9.6",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
